// Finverge VideoPD 2.0 — Digital Loan Origination Portal
// Prototype data model, mirrors FIN-FSD-VIDEOPD-2.0 Section 13 (Key Data Entities).
// SQLite for local-prototype simplicity; swap `provider`/`url` for the LOS data tier in production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Segment {
  FARMER
  VOCATIONAL_STUDENT
  BUSINESS_OWNER
}

enum Language {
  en
  hi
  te
  ta
  kn
  ml
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  ANALYZED
  EXPIRED
}

enum EvidenceType {
  ID_PROOF
  ADDRESS_PROOF
  BUSINESS_PHOTO
  BUSINESS_VIDEO
  SELFIE
  VIDEOPD_LIVENESS              // VideoPD Step 1 capture — distinct from the portal-stage SELFIE
  VIDEOPD_BUSINESS_VERIFICATION // VideoPD Step 3 capture — distinct from portal-stage BUSINESS_PHOTO/VIDEO
  LIVE_CALL_RECORDING           // Borrower-side audio-only recording of the live underwriter call
                                 // (Tier 1 voice-biometrics, see voice-service/README.md and
                                 // LiveCallRoom's recordForVoiceCheck prop) — audio only, never video,
                                 // and only ever captured with the borrower's explicit on-screen consent
                                 // before the call starts. Nothing about the live call is recorded
                                 // without that consent step.
}

enum VideoPdSessionStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
}

enum BankStatementStatus {
  PENDING
  EXTRACTED
  NEEDS_REVIEW // extraction ran but confidence is low (e.g. scanned PDF with no text layer, or too few parsed transaction lines) — flagged for manual underwriter review, never silently treated as clean data
  FAILED
}

enum EligibilityFlag {
  ELIGIBLE
  NEEDS_REVIEW
  NOT_ELIGIBLE
}

enum EvidenceCheckStatus {
  PENDING
  PASSED
  FLAGGED
}

enum LeadStatus {
  NEW
  UNDER_REVIEW
  AWAITING_CHECKER_REVIEW
  SENT_BACK
  VIDEOPD_SCHEDULED
  VIDEOPD_COMPLETE
  APPROVED
  REJECTED
}

// Underwriter Workspace maker-checker (Task: internal staff review, mirrors
// the two-eyes pattern in the DLP LOS staff-portal's FSD-LOS-21, rebuilt
// lightweight here against this prototype's own data rather than DLP's
// separate backend — see conversation decision on which system to extend).
enum UnderwriterRecommendation {
  APPROVE
  REJECT
}

enum ApproverDecision {
  APPROVED
  REJECTED
  SENT_BACK
}

// FSD Section 13 — "Borrower Profile"
model Borrower {
  id            String   @id @default(cuid())
  mobile        String   @unique
  mobileVerified Boolean @default(false)
  name          String?
  dob           String?
  segment       Segment?
  language      Language @default(en)
  addressLine   String?
  consentDataUsage    Boolean @default(false)
  consentBureauPull   Boolean @default(false)
  consentMediaCapture Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  applications  LoanApplication[]
  otps          OtpCode[]
}

// FSD Section 13 — "Loan Application"
model LoanApplication {
  id            String   @id @default(cuid())
  borrowerId    String
  borrower      Borrower @relation(fields: [borrowerId], references: [id])
  segment       Segment
  status        ApplicationStatus @default(DRAFT)

  // Core sections (FSD 4.3.1)
  fullName      String?
  gender        String?
  email         String?
  maritalStatus String?
  dependents    Int?
  currentAddress   String?
  permanentAddress String?
  addressDurationYears Int?
  ownershipStatus  String?
  idType        String?
  idNumber      String?
  productType   String?
  requestedAmount Int?
  tenureMonths  Int?
  loanPurpose   String?
  incomeSource  String?
  monthlyIncome Int?
  existingObligations String?
  bankAccountNumber String?
  bankIfsc      String?
  bankName      String?

  // Segment-specific fields (FSD 4.3.2), stored as JSON for prototype flexibility
  segmentFieldsJson String? // JSON blob: farmer | student | business fields

  // Real client-side device fingerprint (src/lib/deviceFingerprint.ts —
  // canvas/WebGL rendering signature + navigator/screen signals, hashed),
  // captured at submit time. Feeds the SHARED_DEVICE risk flag when the
  // same device shows up across different borrowers' applications
  // (BR-35/36, docs/videopd-future-work.md item 5). Advisory only.
  deviceFingerprint    String?
  deviceSignalsJson    String? // raw component signals (userAgent, screen, timezone, ...), for underwriter transparency — not just an opaque hash

  currentStep   Int      @default(0)
  lastActiveAt  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  evidence      UploadedEvidence[]
  transcripts   ChatTurn[]
  lead          Lead?
  voiceBiometricCheck VoiceBiometricCheck?
}

// FSD Section 13 — "Uploaded Evidence"
model UploadedEvidence {
  id            String   @id @default(cuid())
  applicationId String
  application   LoanApplication @relation(fields: [applicationId], references: [id])
  type          EvidenceType
  fileName      String
  filePath      String
  mimeType      String
  sizeBytes     Int
  geoLat        Float?
  geoLng        Float?
  qualityStatus EvidenceCheckStatus @default(PENDING)
  qualityNotes  String?
  authenticityStatus EvidenceCheckStatus @default(PENDING)
  authenticityNotes  String?

  // Structured liveness/face-match signals behind authenticityStatus above,
  // populated only for VIDEOPD_LIVENESS evidence (see api/videopd/[token]/
  // liveness-result and src/lib/liveness.ts, src/lib/faceMatch.ts) — kept as
  // discrete fields, not just the notes sentence, so the underwriter case
  // page can render them as a real identity-verification panel rather than
  // parsing prose back apart.
  livenessBlinkCount     Int?
  livenessNoFacePct      Int?     // 0-100, % of analyzed frames with no face detected at all
  livenessLookedAwayPct  Int?     // 0-100, % of analyzed frames with a face turned away from camera
  livenessOffCameraGlances Int?   // discrete look-away-then-back events, the actual coaching-detection signal (see AttentionTracker doc comment) — distinct from the cumulative % above
  livenessRecordingSeconds Int?   // clip length; glance flagging is normalized against this rather than a flat count (see evaluateLivenessResult)
  faceMatchDistance      Float?   // Euclidean distance vs. ID proof descriptor; <0.6 conventionally same person
  faceMatchResult        Boolean? // null = not attempted (see authenticityNotes for why)

  createdAt     DateTime @default(now())

  // One evidence item per type per application — the upload UI already only
  // ever tracks a single "existing" row per type per slot (apply/[id]/page.tsx's
  // EVIDENCE_CONFIG + UploadDropzone), so a re-upload was always meant to
  // replace, not add. Nothing enforced that at the DB level, so a re-upload
  // silently created an extra row instead (reported live — 3 ID_PROOF rows
  // on one case). Same pattern as VideoPdAnswer's own
  // @@unique([sessionId, questionKey]) for exactly the same "re-answering
  // upserts in place" reason.
  @@unique([applicationId, type])
}

// FSD Section 13 — "Chatbot Transcript" (one row per turn)
model ChatTurn {
  id            String   @id @default(cuid())
  applicationId String
  application   LoanApplication @relation(fields: [applicationId], references: [id])
  role          String   // "user" | "assistant"
  channel       String   // "voice" | "text"
  language      Language
  text          String
  intent        String?
  fieldUpdated  String?
  createdAt     DateTime @default(now())
}

// FSD Section 13 — "Initial Summary Document"
model InitialSummaryDocument {
  id            String   @id @default(cuid())
  leadId        String   @unique
  lead          Lead     @relation(fields: [leadId], references: [id])
  summaryJson   String   // structured summary: profile snapshot, loan ask, checklist, risk flags
  generatedAt   DateTime @default(now())
}

// FSD Section 13 — "Lead"
model Lead {
  id            String   @id @default(cuid())
  applicationId String   @unique
  application   LoanApplication @relation(fields: [applicationId], references: [id])
  status        LeadStatus @default(NEW)
  riskFlagCount Int      @default(0)
  riskSeverity  String   @default("none") // none | low | medium | high
  assignedUnderwriter String? // staff name who currently holds/claimed this case — claim-ownership only, NOT decision attribution (a re-claim after send-back must not silently reattribute an earlier round's recorded recommendation, see underwriterName below)

  // Maker: underwriter's recommendation. underwriterName is captured at decision
  // time, deliberately separate from assignedUnderwriter — the same asymmetry
  // approverName already has vs. any "claim" concept.
  underwriterName           String?
  underwriterRecommendation UnderwriterRecommendation?
  underwriterNotes          String?
  underwriterDecidedAt      DateTime?

  // Checker: approver's decision (confirms or sends the case back)
  approverName          String?
  approverDecision      ApproverDecision?
  approverNotes         String?
  approverDecidedAt     DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  summary       InitialSummaryDocument?
  videoPdSession VideoPdSession?
  decisions      LeadDecision[]
}

// Full audit trail of every maker-checker round. The single underwriter*/
// approver* fields on Lead above only ever hold the *current* round — a
// re-claim after SENT_BACK overwrites them, so a case that has gone through
// a send-back cycle silently loses its earlier round's recommendation and
// notes from view, even though a real recommend/decide cycle genuinely
// happened. This table is the actual source of truth for "what happened,
// when, by whom" across every round; the single fields on Lead are kept in
// sync alongside it purely as a "current round at a glance" convenience.
model LeadDecision {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  actorRole String   // "UNDERWRITER" | "APPROVER"
  actorName String
  // Underwriter rounds use UnderwriterRecommendation's vocabulary (APPROVE /
  // REJECT); approver rounds use ApproverDecision's (APPROVED / REJECTED /
  // SENT_BACK). Plain string rather than reusing either enum, since neither
  // one alone covers both actors' vocabularies.
  action    String
  notes     String?
  decidedAt DateTime @default(now())

  @@index([leadId])
}

// VideoPD 2.0 guided-flow session (BRD Section 5.3/8.6, BR-21..BR-29) — the
// MVP scope agreed for this build: a sequential guided flow (liveness capture
// → skill/intent Q&A → business verification capture → bank statement upload)
// rather than a live two-way WebRTC call. See docs/videopd-future-work.md for
// what's deliberately deferred (real video calling, deepfake/voice-biometric
// ML, multi-party calls, edge-cloud infra).
model VideoPdSession {
  id            String   @id @default(cuid())
  leadId        String   @unique
  lead          Lead     @relation(fields: [leadId], references: [id])
  token         String   @unique // unguessable id in the borrower-facing link — this prototype's stand-in for a real SMS/WhatsApp-delivered, expiring, authenticated link (BR-21, Dependencies Section 12)
  status        VideoPdSessionStatus @default(NOT_STARTED)
  currentStep   Int      @default(0)
  linkSentAt    DateTime @default(now())
  startedAt     DateTime?
  completedAt   DateTime?

  skillIntentScore Int?    // 0-100, rule-based (BR-24, BR-43) — see lib/videoPdQuestions.ts
  dossierJson      String? // compiled Actionable Dossier once complete (BR-44): score, consistency flags, bank-statement eligibility summary

  answers        VideoPdAnswer[]
  bankStatements BankStatement[]
  callTranscript CallTranscriptSegment[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Real-time transcription of the live WebRTC call (/call/[token],
// LiveCallRoom/useCallRoom) — requested live: the call itself is
// deliberately never recorded (see LiveCallRoom's own doc comment), but a
// text transcript doesn't need the audio/video kept at all. Each
// participant's own browser runs real speech-to-text (Web Speech API,
// same tech as the chatbot's voice input, src/lib/speech.ts) on their own
// microphone and posts each recognized segment here as it's captured —
// genuinely real, not a placeholder, with an honest constraint: it can
// only transcribe what a participant's own local mic picks up, not "listen
// in" on the remote side directly, and needs a Chrome-based browser
// (Web Speech API has limited/no support elsewhere).
model CallTranscriptSegment {
  id          String   @id @default(cuid())
  sessionId   String
  session     VideoPdSession @relation(fields: [sessionId], references: [id])
  speakerName String   // the displayName passed to LiveCallRoom for that participant (e.g. "Borrower", the staff member's name, or a 3rd-party guest's own name)
  text        String
  createdAt   DateTime @default(now())

  @@index([sessionId])
}

model VideoPdAnswer {
  id            String   @id @default(cuid())
  sessionId     String
  session       VideoPdSession @relation(fields: [sessionId], references: [id])
  questionKey   String
  questionText  String   // captured verbatim at answer time so the transcript reads correctly even if the question bank changes later
  answerText    String
  score         Int
  createdAt     DateTime @default(now())

  @@unique([sessionId, questionKey]) // re-answering (e.g. borrower goes back a step) upserts in place rather than duplicating
}

// Voice biometrics — cross-checks the two guided-flow VideoPD recordings
// (VIDEOPD_LIVENESS selfie-step vs. VIDEOPD_BUSINESS_VERIFICATION) against
// each other via a separate Python microservice (see voice-service/README.md
// for what it is and its honest limitations). Staff-triggered, not run
// automatically on upload — the service is a separate process that may not
// be running in every environment, and this whole feature is genuinely
// unvalidated against real borrower audio (see voice-service/README.md
// "Calibration"), so it stays an opt-in check rather than something that
// silently blocks or gates the borrower-facing flow.
model VoiceBiometricCheck {
  id            String   @id @default(cuid())
  applicationId String   @unique
  application   LoanApplication @relation(fields: [applicationId], references: [id])

  // /voice-consistency result — same voice across both recordings?
  consistencyStatus     EvidenceCheckStatus @default(PENDING)
  consistencySimilarity Float?
  consistencyMethod     String?  // "ecapa-tdnn" | "resemblyzer-fallback"
  consistencyNotes      String?

  // /multi-speaker result, one run per clip — more than one voice present?
  livenessMultiSpeakerStatus EvidenceCheckStatus @default(PENDING)
  livenessSpeakerCount       Int?
  businessMultiSpeakerStatus EvidenceCheckStatus @default(PENDING)
  businessSpeakerCount       Int?

  // Tier 1 live-call analysis (see LIVE_CALL_RECORDING evidence type,
  // LiveCallRoom's recordForVoiceCheck prop) — same two checks, run against
  // the borrower-side call recording instead of the guided-flow clips.
  // Kept as separate fields/flag codes from the ones above rather than
  // overwriting them: they're checking different things (the live call vs.
  // the async guided-flow steps) and an underwriter should be able to tell
  // which is which.
  liveCallConsistencyStatus     EvidenceCheckStatus @default(PENDING)
  liveCallConsistencySimilarity Float?
  liveCallConsistencyMethod     String?
  liveCallConsistencyNotes      String?
  liveCallMultiSpeakerStatus    EvidenceCheckStatus @default(PENDING)
  liveCallSpeakerCount          Int?

  // /deepfake-check result, one run per guided-flow clip — frame-level
  // face-manipulation image classifier (see voice-service/README.md's
  // "Deepfake/lip-sync" section for exactly what this is/isn't). No
  // live-call field: LIVE_CALL_RECORDING is deliberately audio-only (see
  // useCallAudioRecorder.ts), so there's no video to run this against.
  // Gated behind FeatureSettings.deepfakeCheckEnabled — see
  // src/lib/featureSettings.ts.
  livenessDeepfakeStatus  EvidenceCheckStatus @default(PENDING)
  livenessDeepfakeRatio   Float?
  businessDeepfakeStatus  EvidenceCheckStatus @default(PENDING)
  businessDeepfakeRatio   Float?
  deepfakeModel           String?

  // /lip-sync-check result, one run per guided-flow clip — LipForensics
  // (MIT-licensed, CVPR 2021) forgery score from real lip-region temporal
  // analysis. Same "no live-call field" reasoning as deepfake above. Gated
  // behind FeatureSettings.lipSyncCheckEnabled.
  livenessLipSyncStatus  EvidenceCheckStatus @default(PENDING)
  livenessLipSyncScore   Float?
  businessLipSyncStatus  EvidenceCheckStatus @default(PENDING)
  businessLipSyncScore   Float?
  lipSyncModel           String?

  // /asset-detection-check result — Phase 1 of the customer-requested
  // "AI asset scoring" ask (see the feasibility note this was scoped
  // from). Runs ONLY against VIDEOPD_BUSINESS_VERIFICATION (the
  // work-premises video) — a real, general-purpose object detector
  // (RT-DETR, COCO-pretrained — swapped from torchvision's Faster R-CNN
  // after real testing showed it faster and less prone to false
  // positives on this app's own footage) producing a checklist of
  // generic categories detected — see voice-service/asset_detection.py's
  // own doc comment for the full honest scope. No liveness-clip
  // counterpart: the selfie-step recording isn't a premises video,
  // nothing to detect assets in. Gated behind
  // FeatureSettings.assetDetectionCheckEnabled.
  assetDetectionStatus         EvidenceCheckStatus @default(PENDING)
  assetDetectionChecklistJson  String? // JSON array: [{ label: string, count: number, confidence: number }], sorted by count desc
  assetDetectionModel          String?
  assetDetectionNotes          String?
  // /custom-asset-detection-check result — the direct answer to "we're
  // still only using COCO categories, not the segment-specific custom
  // objects": an OPEN-VOCABULARY/zero-shot detector (OWLv2, see
  // voice-service/custom_asset_detection.py), queried at inference time
  // with this segment's manual-item list
  // (AssetDetectionSegmentSettings.manualItemsJson) — genuinely different
  // from assetDetectionStatus above, which can only ever output one of a
  // fixed 80 categories. Real detection, not a training-based guess, but
  // zero-shot accuracy runs meaningfully below a closed-vocabulary
  // detector and this has never been benchmarked against real Indian
  // premises footage — surfaced to the underwriter as a suggestion,
  // pre-filling assetChecklistManualTicksJson below rather than replacing
  // the human tick outright. Same business-verification-clip-only scope
  // as assetDetectionStatus.
  customAssetDetectionStatus        EvidenceCheckStatus @default(PENDING)
  customAssetDetectionChecklistJson String? // JSON array: [{ label: string, count: number, confidence: number }]
  customAssetDetectionModel         String?
  customAssetDetectionNotes         String?
  // Which of this segment's manual reference items
  // (AssetDetectionSegmentSettings.manualItemsJson) the underwriter has
  // confirmed — JSON array of label strings, editable any time on the
  // case page, independent of when any AI check last ran. Pre-filled from
  // customAssetDetectionChecklistJson's high-confidence hits when a fresh
  // check runs (see runVoiceCheck.ts), but always a human-owned field
  // from that point on — the underwriter can add or remove any item,
  // AI-suggested or not, and it stays exactly as they left it.
  assetChecklistManualTicksJson String?
  // Weighted total over the AI-detected checklist (COCO), the zero-shot
  // custom-detected checklist, AND the manually-ticked items together —
  // AssetDetectionSegmentSettings.weightsJson applied to whichever labels
  // are present across all three, deduped once per distinct label.
  // Recomputed whenever any input changes (a fresh AI run of either kind,
  // or the underwriter editing manual ticks) — see
  // computeAssetChecklistScore in src/lib/assetDetectionSegmentSettings.ts.
  // An admin-configured rubric total, NOT an outcome-calibrated
  // valuation — that still needs Lakshya's real loan-performance data
  // (Phase 2, unchanged). Stated explicitly wherever this number is
  // shown, same honesty standard as every other score-shaped number in
  // this codebase.
  assetChecklistScore Float?

  checkedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Bank statement upload + local extraction (this conversation's explicit ask:
// ICR/local extraction rather than a paid statement-analyzer service like
// Perfios). See lib/bankStatement.ts for the extraction/eligibility pipeline.
model BankStatement {
  id            String   @id @default(cuid())
  sessionId     String
  session       VideoPdSession @relation(fields: [sessionId], references: [id])
  fileName      String
  filePath      String
  mimeType      String
  status        BankStatementStatus @default(PENDING)
  extractedText String?  // raw OCR/PDF-text-layer output, kept for underwriter spot-checking against the parsed transactions below
  transactionsJson String? // parsed { date, description, debit, credit, balance }[]
  metricsJson      String? // { avgBalance, minBalance, totalCredits, totalDebits, bounceCount, estimatedMonthlyIncome, emiOutflow }
  eligibilityFlag        EligibilityFlag?
  eligibilityReasonsJson String? // string[] — always populated alongside eligibilityFlag so the underwriter sees *why*, never a bare verdict

  // Real, deterministic document-authenticity signals (src/lib/bankStatement.ts's
  // checkPdfMetadata + checkTransactionIntegrity) — PDF revision count/
  // suspicious editing-tool metadata, and independent balance-vs-transaction
  // arithmetic reconciliation. NOT a claim of detecting doctored visual
  // content (a logo/image alteration) — that needs real image-forensics ML,
  // explicitly out of scope, same footing as this app's other refused
  // ML-only checks (see docs/videopd-future-work.md).
  authenticityStatus       EvidenceCheckStatus @default(PENDING)
  authenticityReasonsJson  String? // string[] — always populated alongside authenticityStatus, PASSED included, same convention as eligibilityReasonsJson
  createdAt     DateTime @default(now())
}

enum QuestionStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

// VideoPD Step 2 skill/intent Q&A, now admin-managed (BR-43: "configurable
// against a lending partner's own credit parameters", extended per this
// conversation to a draft -> review -> approve workflow instead of a
// hardcoded file) — mirrors the maker-checker two-role split already used
// for case decisions: any staff member drafts a question, only an APPROVER
// can publish it, and only APPROVED questions are ever shown to a borrower.
model VideoPdQuestionConfig {
  id         String   @id @default(cuid())
  segment    Segment
  key        String   // stable identifier carried into VideoPdAnswer.questionKey
  orderIndex Int      @default(0)
  status     QuestionStatus @default(DRAFT)

  promptEn String
  promptHi String? // auto-translated on creation (see lib/translate.ts), editable before approval
  promptTe String?
  promptTa String?
  promptKn String?
  promptMl String?

  createdBy  String?
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([segment, key])
}

// BR-43's "configurable against a lending partner's own credit parameters"
// — a real, staff-editable risk-parameter set, not hardcoded constants.
// Seeded with generic, industry-standard microfinance/NBFC underwriting
// conventions (see src/lib/riskParameters.ts for citations), not Lakshya's
// own calibrated risk appetite — BRD Section 12 lists that as an explicit
// external dependency ("pending their baseline credit questionnaire and risk
// parameters"). The point of this model is exactly that gap: once Lakshya
// provides real numbers, updating them is a form submission during UAT, not
// an engineering change and a redeploy.
//
// Keyed by segment (id = "FARMER" | "VOCATIONAL_STUDENT" | "BUSINESS_OWNER"),
// not one global singleton — farm income is seasonal, a vocational student
// typically has no current income at all, so these genuinely may need
// different real numbers per segment. All three seed with the same generic
// defaults (see riskParameters.ts's doc comment for why: no rigorous basis
// exists yet to invent different starting numbers) but are independently
// editable at /staff/risk-parameters.
model RiskParameters {
  id                            String   @id // one of the Segment enum's values
  maxLoanToIncomeMultiple       Float    @default(36)   // requested amount vs monthly income — was a hardcoded magic number in mockChecks.ts, now here
  assumedAnnualInterestRatePct  Float    @default(24)    // used only to estimate EMI for the affordability check below — not a real quoted rate, no rate is captured elsewhere in this data model
  maxEmiToIncomeRatioPct        Float    @default(50)    // FOIR-style affordability cap: estimated EMI / stated monthly income
  updatedBy                     String?
  updatedAt                     DateTime @updatedAt
}

// Which of the 80 COCO categories (src/lib/assetDetectionCategories.ts)
// the work-premises asset checklist is allowed to surface, per segment —
// requested live: what's worth listing genuinely differs by segment (a
// farmer's premises checklist cares about things like "cow"/"truck", a
// vocational student's about "laptop"/"book"/"chair"). Same
// id-is-the-segment-value, one-row-per-segment pattern as RiskParameters
// above, and deliberately its OWN model rather than bolted onto either:
// not RiskParameters, a different kind of thing (scoring inputs, not
// detection scope); not FeatureSettings, which is explicitly app-wide, not
// per-segment (see that model's own doc comment). The on/off switch for
// the check itself (FeatureSettings.assetDetectionCheckEnabled) stays
// global — this only controls WHICH categories a segment's checklist may
// list once the check is on. A segment's row is seeded on first touch
// with that segment's curated starting list
// (ASSET_DETECTION_DEFAULT_CATEGORIES_BY_SEGMENT in
// assetDetectionCategories.ts), NOT "all 80" — see that constant's own
// doc comment for why. categoriesJson only reads as NULL if something
// external cleared it; every reader still treats that defensively as "all
// categories" rather than erroring.
//
// This is the LIVE, currently-in-effect configuration — edited only
// through maker-checker (/staff/asset-scorecard, AssetScorecardRevision
// below), never by a direct save. The one exception is
// addApprovedCategory, which already goes through its own separate
// Approver sign-off (AssetDetectionCategoryRequest).
model AssetDetectionSegmentSettings {
  segment        String   @id // one of the Segment enum's values
  categoriesJson String?
  // Per-label point value for this segment's weighted checklist score —
  // JSON object {label: number}, covering BOTH AI-detected COCO labels
  // (categoriesJson above) and this segment's manual reference items
  // (manualItemsJson below), same keyspace either way. Missing key = not
  // yet configured, treated as weight 0 (contributes nothing) rather than
  // erroring. Requested live, in-house-owned (no Lakshya dependency) —
  // see computeAssetChecklistScore's own doc comment for exactly what
  // this score is and, more importantly, what it ISN'T: an admin-set
  // rubric, not an outcome-calibrated valuation. That still needs
  // Lakshya's real loan-performance data (Phase 2, unchanged).
  weightsJson String?
  // Curated, India-relevant workshop/institute/farm equipment names for
  // this segment that the detector can NEVER recognize (torchvision's
  // COCO-pretrained model has a fixed 80-category vocabulary — see
  // AssetDetectionCategoryRequest's doc comment) — sewing machine, lathe,
  // power tiller, irrigation pump, and similar. JSON array of label
  // strings. Surfaced to the underwriter as manual checkboxes on the case
  // page (VoiceBiometricCheck.assetChecklistManualTicksJson) — a human
  // visually confirms presence, the system doesn't. Seeded from domain
  // knowledge, not scraped/trained on images — no licensing exposure,
  // because no image ever backs one of these entries.
  manualItemsJson String?
  updatedBy      String?
  updatedAt      DateTime @updatedAt
}

// Underwriter-proposed additions to a segment's asset-detection category
// list, subject to Approver sign-off — requested live ("add new object
// names if required, added by underwriter and approved by approver").
//
// IMPORTANT, and stated everywhere this surfaces in the UI: approving a
// request here does NOT teach the detector a new category. The underlying
// model (RT-DETR, COCO-pretrained — see voice-service/asset_detection.py)
// has a fixed, closed vocabulary of 80 categories; it can never output a
// label outside that set no matter what gets approved here. Recognizing
// a genuinely new object type (a sewing
// machine, an irrigation pump) needs a fine-tuned or different model,
// which needs Lakshya's own labeled data first (Phase 2 — see the
// feasibility note this whole feature was scoped from). What this table
// actually is: a governance trail of what underwriters wish the checklist
// covered, for whoever scopes Phase 2 to read — not a live capability
// toggle. An approved request still gets added to that segment's
// AssetDetectionSegmentSettings.categoriesJson allow-list (so a future
// model swap that DOES recognize the label doesn't need this step
// redone), but until then, approving one changes nothing about what a
// check run can actually detect.
model AssetDetectionCategoryRequest {
  id          String                @id @default(cuid())
  segment     Segment
  label       String // free-text requested object name, e.g. "sewing machine"
  requestedBy String
  note        String?
  status      CategoryRequestStatus @default(PENDING)
  decidedBy   String?
  decidedAt   DateTime?
  createdAt   DateTime              @default(now())
}

enum CategoryRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Maker-checker revision for a segment's WHOLE asset scorecard
// (categories + weights + manual items together, one edit session — see
// /staff/asset-scorecard) — requested live: bulk scorecard edits should
// go through the same propose/approve separation as an individual
// category request, not a direct save. A staff member (any role) PROPOSES
// a full replacement snapshot; a DIFFERENT Approver must decide it before
// it becomes live — decideAssetScorecardRevision (src/lib/
// assetScorecardRevisions.ts) rejects a decidedBy equal to proposedBy,
// enforcing genuine four-eyes review, not just an Approver-role check.
// AssetDetectionSegmentSettings only ever gets overwritten by an
// APPROVED revision here — never by a direct PUT from the config page
// itself, which is what makes this a real maker-checker flow rather than
// "Approver edits it themselves."
model AssetScorecardRevision {
  id              String                @id @default(cuid())
  segment         Segment
  categoriesJson  String // full proposed AI-category allow-list, same shape as AssetDetectionSegmentSettings.categoriesJson
  weightsJson     String // full proposed {label: weight} map
  manualItemsJson String // full proposed manual-item list
  proposedBy      String
  note            String?
  status          CategoryRequestStatus @default(PENDING)
  decidedBy       String?
  decidedAt       DateTime?
  createdAt       DateTime              @default(now())
}

// Global on/off switch for experimental checks — requested live: deepfake
// detection explicitly needed to be admin-toggleable so it can be turned
// off later without an engineering change, given it's genuinely research-
// grade (see voice-service/README.md's "Deepfake/lip-sync" section for
// exactly what that means and why, including why lip-sync itself isn't
// shipped here — a real, hands-on-verified blocker, not a skipped attempt).
// Singleton row (id="global"), same staff-editable pattern as
// RiskParameters above, just a boolean instead of numbers — deliberately a
// separate model rather than bolted onto RiskParameters, since this isn't
// an underwriting-policy number and applies app-wide, not per-segment.
model FeatureSettings {
  id                     String   @id @default("global")
  deepfakeCheckEnabled   Boolean  @default(true)
  lipSyncCheckEnabled    Boolean  @default(true)
  // Phase 1 work-premises asset-detection checklist (see
  // VoiceBiometricCheck.assetDetectionStatus and
  // voice-service/asset_detection.py) — its own toggle, same reasoning as
  // the two above: a real but genuinely limited capability (generic COCO
  // categories, not domain-specific assets), staff should be able to turn
  // it off without an engineering change if it turns out to be more noise
  // than signal for a given lending partner.
  assetDetectionCheckEnabled Boolean @default(true)
  // How many days a DRAFT application still counts as "in progress" for the
  // duplicate-application check on the landing page (api/application/
  // duplicate-check/route.ts) — global, not per-segment, same reasoning as
  // the two toggles above: this is a platform behavior, not an
  // underwriting-policy number like RiskParameters. Past this many days
  // since the draft's own lastActiveAt, it stops blocking/offering a
  // resume prompt and a fresh application can start normally; the stale
  // draft itself is left alone, not deleted or auto-marked EXPIRED.
  applicationExpiryDays  Int      @default(30)
  updatedBy              String?
  updatedAt              DateTime @updatedAt
}

// Mock OTP store — dev-mode only stand-in for the SMS gateway (BRD Dependencies)
model OtpCode {
  id         String   @id @default(cuid())
  borrowerId String
  borrower   Borrower @relation(fields: [borrowerId], references: [id])
  code       String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())
}
